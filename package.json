{
  "name": "freebuff-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Freebuff Desktop — Support Voice Agent: meeting etiquette state machine with Jira, log (Splunk/CloudWatch), runbook, and Slack integrations",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx scripts/eval.ts",
    "eval:retrieval": "tsx scripts/retrieval-eval.ts",
    "eval:faithfulness": "tsx scripts/faithfulness-eval.ts",
    "prepare": "test -d .git && git config core.hooksPath .githooks || true",
    "demo": "tsx demo/cli.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
