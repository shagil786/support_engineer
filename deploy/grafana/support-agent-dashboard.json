{
  "__inputs_note": "Import as-is; Grafana prompts for the Prometheus datasource. Every metric charted here is rendered by src/http/metrics.ts — the contract is pinned by tests/dashboard.test.ts, so a rename on either side fails CI.",
  "title": "Support Agent — Governed Ops",
  "uid": "support-agent-ops",
  "description": "Out-of-the-box view of the support agent's event-spine metrics: LLM provider health and cost, integration latency, governed-run outcomes, policy decisions, SafetyNet vetoes, review-retry recovery, and the human-approval lifecycle. Requires only GET /metrics scraped by Prometheus (bearer token in the scrape config).",
  "tags": ["support-agent"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "timezone": "",
  "weekStart": "",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "links": [],
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "refresh": 1,
        "current": {},
        "options": []
      },
      {
        "name": "job",
        "type": "query",
        "label": "Scrape job",
        "definition": "label_values(support_agent_agent_outcomes_total, job)",
        "query": { "query": "label_values(support_agent_agent_outcomes_total, job)", "refId": "job-variable" },
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "LLM provider",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Call error rate",
      "description": "share of LLM completions that failed, over the range",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(support_agent_llm_calls_total{ok=\"false\",job=~\"$job\"}[$__rate_interval])) / sum(rate(support_agent_llm_calls_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 25 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "type": "stat",
      "title": "Completion p95",
      "description": "95th percentile LLM completion latency",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(support_agent_llm_latency_ms_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2500 },
              { "color": "red", "value": 5000 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "textMode": "auto" }
    },
    {
      "type": "timeseries",
      "title": "Call rate by outcome",
      "description": "LLM completions per second; circuit breaker openings show as circuit_open spikes in the panel below",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ok) (rate(support_agent_llm_calls_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{ok}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Completion latency percentiles",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(support_agent_llm_latency_ms_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(support_agent_llm_latency_ms_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(support_agent_llm_latency_ms_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Token burn rate by model",
      "description": "prompt + completion tokens per second — the cost line",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(support_agent_llm_tokens_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Failures by error code",
      "description": "http_error = provider trouble; circuit_open = the breaker refusing to hammer a saturated provider",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_code) (rate(support_agent_llm_calls_total{ok=\"false\",job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{error_code}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Tools & integrations",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tool call rate by tool and outcome",
      "description": "jira, query_logs, runbook, notify, interrupt — governed executions only",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, ok) (rate(support_agent_tool_calls_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{tool}} {{ok}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Tool latency p95 by tool",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(support_agent_tool_latency_ms_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Governed runs & policy",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Governed run outcomes",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (ok) (rate(support_agent_agent_outcomes_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{ok}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "Policy decisions by effect",
      "description": "allow / deny / require_approval — stacked; require_approval volume is your governance load",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (effect) (rate(support_agent_governance_decisions_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{effect}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 35, "stacking": { "mode": "normal", "group": "1" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries",
      "title": "SafetyNet vetoes by check",
      "description": "which guardrail fires — cost caps, loop veto, output filters",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (check) (rate(support_agent_safety_net_vetoes_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{check}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row",
      "title": "Review quality",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Review recovery rate",
      "description": "share of retried runs that still ended ok — how often the reviewer's re-dance saves a run instead of failing it",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(support_agent_review_retries_total{outcome=\"recovered\",job=~\"$job\"}) / sum(support_agent_review_retries_total{outcome=\"retried\",job=~\"$job\"})",
          "legendFormat": "recovery %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "type": "timeseries",
      "title": "Review retries by outcome and depth",
      "description": "runs that passed review only after a re-dance, split by final result and depth — one_shot = the first repair landed, repeated = 2+ repairs (thrash); a rising failed share means feedback isn't landing in the re-plan, a rising repeated share means it isn't landing on the first try",
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome, depth) (rate(support_agent_review_retry_depth_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}/{{depth}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "stat",
      "title": "Review thrash share",
      "description": "share of retried runs that needed 2+ repairs — healthy feedback loops repair on the first try; a rising share is the reviewer and re-plan disagreeing repeatedly",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(support_agent_review_retry_depth_total{depth=\"repeated\",outcome=\"retried\",job=~\"$job\"}[$__rate_interval])) / sum(rate(support_agent_review_retries_total{outcome=\"retried\",job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "thrash %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 40 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "type": "row",
      "title": "Human approvals",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Approvals awaiting action",
      "description": "requested minus granted minus timed out — the open M-of-N queue",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(support_agent_approvals_total{outcome=\"requested\",job=~\"$job\"}) - sum(support_agent_approvals_total{outcome=\"granted\",job=~\"$job\"}) - sum(support_agent_approvals_total{outcome=\"timed_out\",job=~\"$job\"})",
          "legendFormat": "open"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "textMode": "auto" }
    },
    {
      "type": "timeseries",
      "title": "Approval lifecycle rate",
      "description": "requests vs grants vs timeouts — a widening gap between requested and granted is approver pain",
      "gridPos": { "h": 8, "w": 20, "x": 4, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(support_agent_approvals_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
