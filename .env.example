[TEMPLATE]
# Freebuff Desktop — Support Voice Agent environment
#
# HOW TO USE:
#   1. cp .env.example .env
#   2. Open .env and replace the placeholder values with your real ones.
#   3. Run the agent. .env is auto-loaded from the repo root at startup
#      (src/env.ts); real shell environment variables always win over it.
#
# .env is git-ignored — never commit secrets.
# Every integration is optional: leave a group unset and the agent runs
# unwired for that backend (it will say so instead of guessing a server).

# --- Jira -------------------------------------------------------------
# Required for any Jira wiring:
JIRA_BASE_URL=https://your-company.atlassian.net
# 'bearer' (default) or 'basic':
JIRA_AUTH_TYPE=bearer
# For JIRA_AUTH_TYPE=bearer:
JIRA_BEARER_TOKEN=
# For JIRA_AUTH_TYPE=basic:
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# Optional default project key used when filing issues:
# JIRA_PROJECT_KEY=

# --- Slack (meeting summary posting) ------------------------------------
# SLACK_WEBHOOK_URL=
# Bot token (xoxb-) upgrades approvals: Block Kit cards, emoji sign-off,
# in-place lifecycle updates, thread replies.
# SLACK_BOT_TOKEN=
# Signing secret for /slack/events + /slack/interactive (HMAC-verified):
# SLACK_SIGNING_SECRET=

# --- HTTP surface (fail-closed) ------------------------------------------
# The server starts ONLY when a bearer token exists — it never opens
# unauthenticated. Roles resolve server-side (SPEAKER + APPROVERS = admin).
# HTTP_TOKEN=change-me-to-a-long-random-string   # comma-separated for several
# HTTP_HOST=0.0.0.0    # containers must bind 0.0.0.0 (the image sets this)
# HTTP_PORT=8787
# RATE_LIMIT_PER_MINUTE=120   # per-credential; 429s carry Retry-After

# --- Splunk logs ---------------------------------------------------------
# Both are required to wire the Splunk log provider:
# SPLUNK_URL=
# SPLUNK_TOKEN=

# --- AWS CloudWatch Logs (host-provided signer) --------------------------
# CloudWatch needs a SigV4 signer supplied by the host (see CloudWatchConfig);
# these are read by the host's AWS SDK setup, not by configFromEnv().
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- LLM (cloud-hosted model — add your key later) ------------------------
# Any OpenAI-compatible endpoint works (inferX, OpenAI, OpenRouter, Ollama,
# vLLM). Powers: intent classification, the sub-agent dance, grounded
# answering (POST /ask, live voice questions), and the LLM faithfulness judge.
# LLM_BASE_URL=https://api.inferx.example/v1
# LLM_API_KEY=              # <-- fill in when ready
# LLM_MODEL=gpt-4o
# LLM_TIMEOUT_MS=30000

# --- Embeddings (optional — upgrades KB retrieval beyond lexical hashing) --
# EMBEDDINGS_PROVIDER selects the backend:
#   local  (recommended) — real semantic embeddings in-process via
#     transformers.js (all-MiniLM-L6-v2, 384-dim). No key, no URL, no data
#     leaves the machine. Optional EMBEDDINGS_MODEL overrides the HF id.
#   remote — an OpenAI-compatible /embeddings endpoint; BASE_URL, API_KEY
#     and MODEL are then required together.
# After a backend swap run: npx tsx scripts/knowledge-cli.ts reindex
# EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDINGS_DIM=256        # folds longer model vectors to this dimension (>= 8)
#
# Remote example (only when EMBEDDINGS_PROVIDER=remote):
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_MODEL=text-embedding-3-small

# --- Runbooks + deployment -------------------------------------------------
# RUNBOOKS_FILE=/data/runbooks.json   # catalog; validated loudly at boot
# DATA_DIR=/data                      # all runtime state (volume in containers)
# APPROVERS=U-slack-id-1,U-slack-id-2 # extra trusted admin ids
# APPROVAL_CHANNEL=#support-agent-approvals
# APPROVAL_TIMEOUT_MS=300000          # staged-approval pending window
# SERVE_KEEP_ALIVE=1                  # detached/container mode: ignore closed stdin
#
# Containers: docker build -t support-agent . && docker run --rm -p 8787:8787
#   --env-file .env -v agent-data:/data support-agent  (see Dockerfile)

# --- Learning loop (off unless explicitly enabled) -------------------------
# LEARNING_ENABLED=true
# LEARNING_INTERVAL_MS=3600000

# --- Supervisor caps (each optional, floor-checked) ------------------------
# SUPERVISOR_MAX_WALLCLOCK_MS=60000
# SUPERVISOR_MAX_HOPS=8
# SUPERVISOR_MAX_TOKENS=50000
# SUPERVISOR_MAX_IDENTICAL_TOOL_CALLS=3
