# Freebuff Desktop — Support Voice Agent environment
#
# HOW TO USE:
#   1. cp .env.example .env
#   2. Open .env and replace the placeholder values with your real ones.
#   3. Run the agent. .env is auto-loaded from the repo root at startup
#      (src/env.ts); real shell environment variables always win over it.
#
# .env is git-ignored — never commit secrets.
# Every integration is optional: leave a group unset and the agent runs
# unwired for that backend (it will say so instead of guessing a server).

# --- Jira -------------------------------------------------------------
# Required for any Jira wiring:
JIRA_BASE_URL=https://your-company.atlassian.net
# 'bearer' (default) or 'basic':
JIRA_AUTH_TYPE=bearer
# For JIRA_AUTH_TYPE=bearer:
JIRA_BEARER_TOKEN=
# For JIRA_AUTH_TYPE=basic:
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# Optional default project key used when filing issues:
# JIRA_PROJECT_KEY=

# --- Slack (meeting summary posting) ------------------------------------
# SLACK_WEBHOOK_URL=

# --- Splunk logs ---------------------------------------------------------
# Both are required to wire the Splunk log provider:
# SPLUNK_URL=
# SPLUNK_TOKEN=

# --- AWS CloudWatch Logs (host-provided signer) --------------------------
# CloudWatch needs a SigV4 signer supplied by the host (see CloudWatchConfig);
# these are read by the host's AWS SDK setup, not by configFromEnv().
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- LLM (cloud-hosted model — add your key later) ------------------------
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=              # <-- fill in when ready
# LLM_MODEL=gpt-4o
